# (예전 방식, 도커 전환 전) systemd 로 jar 를 직접 실행할 때 쓰던 서비스 파일. 지금은 deploy/compose.yml + deploy.sh 를 쓴다.
# /etc/systemd/system/haruhanpan.service
[Unit]
Description=Haruhanpan personal dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=haruhanpan
WorkingDirectory=/opt/haruhanpan
EnvironmentFile=/etc/haruhanpan.env
ExecStart=/usr/bin/java -Xms64m -Xmx384m -XX:+UseSerialGC -jar /opt/haruhanpan/haruhanpan.jar
SuccessExitStatus=143
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/haruhanpan
PrivateTmp=true

[Install]
WantedBy=multi-user.target
