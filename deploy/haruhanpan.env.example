# /etc/haruhanpan.env  (sudo chmod 600, 소유자 root)
# 이 파일은 예시. 실제 값은 서버의 /etc/haruhanpan.env 에만 둔다 (git 에 넣지 않음).

SPRING_PROFILES_ACTIVE=prod
HARU_DATA_DIR=/var/lib/haruhanpan

ORA_USER=HARUHANPAN
ORA_PASSWORD=바꿀것

# (A) 지갑 없이 TLS 접속 — ADB 네트워크를 "허용된 IP" 로 제한하고 mTLS 필수를 해제한 경우
#     OCI 콘솔 > ADB > 데이터베이스 연결 > TLS 접속 문자열(_tp) 을 복사해 앞에 jdbc:oracle:thin:@ 를 붙인다
ORA_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.ap-chuncheon-1.oraclecloud.com))(connect_data=(service_name=xxxx_haruhanpan_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# (B) 지갑(mTLS) 방식 — 지갑 zip 을 /var/lib/haruhanpan/wallet 에 풀고 위 ORA_URL 대신 사용
# ORA_URL=jdbc:oracle:thin:@haruhanpan_tp?TNS_ADMIN=/var/lib/haruhanpan/wallet

# Google 로그인 (선택) — 두 값이 있어야 로그인 화면에 Google 버튼이 나온다. DEPLOY.md "Google 로그인" 참고
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=바꿀것
# 이 Google Workspace 도메인 계정은 초대·승인 없이 바로 가입
# HARU_GOOGLE_ALLOWED_DOMAIN=mycompany.com
# 그 외 Google 계정의 가입 신청(관리자 승인 필요)을 막으려면 false (기본 true)
# HARU_GOOGLE_OPEN_SIGNUP=false
